# Copy this file to evaluation/.env and fill in real values.
# evaluation/scripts/run_eval.py calls load_dotenv() at startup, so anything
# defined here (or in a real .env) is picked up automatically.
#
# profiles.json only stores *environment variable names*, never secrets
# (see configs/profiles.example.json). Set the actual key/url values here.
#
# You don't need all nine variables — only fill in the ones referenced by
# the profile you actually use (see configs/profiles.example.json).

# --- Agent model (the model under test) ---
OMNIABENCH_AGENT_API_KEY=
OMNIABENCH_AGENT_BASE_URL=

# --- User-simulator model (plays the human side of the conversation) ---
OMNIABENCH_USER_API_KEY=
OMNIABENCH_USER_BASE_URL=

# --- Rubric judge model (scores agent transcripts against the rubric) ---
OMNIABENCH_JUDGE_API_KEY=
OMNIABENCH_JUDGE_BASE_URL=
